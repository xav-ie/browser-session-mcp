# Shared configuration for the browser-session systemd units.
# Installed to /etc/browser-session/browser-session.env — edit to taste.
# Every value here is also a plain env var (see the README), so the same file
# works whether you run the units or launch the binary by hand.

# --- Chrome the daemons talk to (you run this yourself; see the README) ------
# DevTools HTTP(S) endpoint. TLS is supported (e.g. https://chrome.example.com).
BROWSER_URL=http://127.0.0.1:9222

# --- Shared state (must be identical across all units) -----------------------
STATE_FILE=/var/lib/browser-session/state.json
LOGS_DIR=/var/lib/browser-session/logs
STATES_DIR=/var/lib/browser-session/states
TAKEOVER_DIR=/var/lib/browser-session/takeover

# --- reaper ------------------------------------------------------------------
# Close sessions idle longer than this many hours.
MAX_IDLE_HOURS=24

# --- takeover ----------------------------------------------------------------
TAKEOVER_BIND=127.0.0.1:9223
# Public base URL of the CDP WebSocket the takeover page connects to directly.
CHROME_WS_BASE=wss://chrome.example.com
# The takeover UI shipped in the release tarball (the extracted webroot/ dir).
TAKEOVER_WEBROOT=/usr/local/share/browser-session/webroot
