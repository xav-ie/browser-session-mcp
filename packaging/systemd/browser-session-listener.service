[Unit]
Description=browser-session event listener (console + network → NDJSON)
# If you run Chrome as a systemd unit too, order after it:
# After=chrome-headless.service
# Requires=chrome-headless.service
After=network.target

[Service]
Type=simple
EnvironmentFile=/etc/browser-session/browser-session.env
ExecStart=/usr/local/bin/browser-session listener
# The listener re-subscribes to CDP on disconnect; if it crashes outright,
# restart fast — its downtime is the only console/network capture gap.
Restart=always
RestartSec=2
StateDirectory=browser-session

[Install]
WantedBy=multi-user.target
