---
import Base from "../layouts/base.astro";
---

<Base>
  {
    /* One bar: navigation, new tab, and the credential relay as a
      popover, so the screencast gets the rest of the screen. */
  }
  <nav id="tabs" hidden></nav>

  <header id="bar">
    <button id="back" title="Back"></button>
    <button id="fwd" title="Forward"></button>
    <input
      id="url"
      type="text"
      spellcheck="false"
      autocomplete="off"
      placeholder="Enter a URL and press Enter"
    />
    <button id="newtab" title="Open a new tab"></button>
    <button id="keys" popovertarget="vault" title="Fill username or password"
    ></button>
    <button
      id="done"
      disabled
      title="Hand control back to the agent. It resumes and normal network logging turns back on."
      >Done</button
    >
  </header>

  <form id="vault" popover autocomplete="on" action="#" onsubmit="return false">
    {
      /* A real login form so your local password manager recognizes it and
        autofills. Values are read same-origin and typed into the remote page's
        focused field over CDP. */
    }
    <p>Autofill here, then send each into the field focused on the page.</p>
    <div class="row">
      <input
        id="vu"
        type="text"
        name="username"
        autocomplete="username"
        placeholder="username"
      />
      <button type="button" data-for="vu"><span>send</span></button>
    </div>
    <div class="row">
      <input
        id="vp"
        type="password"
        name="password"
        autocomplete="current-password"
        placeholder="password"
      />
      <button type="button" data-for="vp"><span>send</span></button>
    </div>
  </form>

  <div id="wrap">
    <canvas id="screen" width="1280" height="800" tabindex="0"></canvas>
  </div>
  <div id="toast" role="alert" hidden></div>
  <div id="overlay"></div>

  <script>
    import "../lib/takeover.ts";
  </script>
</Base>
