---
import Base from "../layouts/base.astro";
---

<Base>
  {/* One bar: navigation, new tab, and the credential relay as a
      popover, so the screencast gets the rest of the screen. */}
  <nav id="tabs" hidden></nav>

  <header id="bar">
    <button id="back" title="Back"></button>
    <button id="fwd" title="Forward"></button>
    <input
      id="url"
      type="text"
      spellcheck="false"
      autocomplete="off"
      placeholder="Enter a URL and press Enter"
    />
    <button id="newtab" title="Open a new tab"></button>
    <button
      id="keys"
      popovertarget="vault"
      title="Fill username, password or one-time code"
    ></button>
    <div id="actions">
      <button
        id="end"
        disabled
        title="Close this link for good. The agent keeps control and you can no longer watch."
      >
        End
      </button>
      <button id="control" disabled>
        Hand back
      </button>
    </div>
  </header>

  <form
    id="vault"
    popover="manual"
    autocomplete="on"
    action="#"
    onsubmit="return false"
  >
    {/* A real login form so your local password manager recognizes it and
        autofills. Values are read same-origin and typed into the remote page's
        fields over CDP. Manual popover: it stays open while you use the page
        and closes only from its own close button or the key button. */}
    <div class="head">
      <p>
        Fill these from your password manager. Autofill then logs in: username
        and password, submit, then the one-time code on the next step. Or send
        one value into the focused field.
      </p>
      <button
        type="button"
        id="vaultclose"
        popovertarget="vault"
        popovertargetaction="hide"
        title="Close"
      ></button>
    </div>
    <div class="row">
      <input
        id="vu"
        type="text"
        name="username"
        autocomplete="username"
        placeholder="username"
      />
      <button type="button" data-for="vu">
        <span>send</span>
      </button>
    </div>
    <div class="row">
      <input
        id="vp"
        type="password"
        name="password"
        autocomplete="current-password"
        placeholder="password"
      />
      <button type="button" data-for="vp">
        <span>send</span>
      </button>
    </div>
    <div class="row">
      <input
        id="vo"
        type="text"
        name="one-time-code"
        inputmode="numeric"
        autocomplete="one-time-code"
        placeholder="one-time code"
      />
      <button type="button" data-for="vo">
        <span>send</span>
      </button>
    </div>
    <button
      type="button"
      id="autologin"
      title="Fill username and password, submit, then fill the one-time code on the next step and submit again"
    >
      Autofill
    </button>
  </form>

  <div id="wrap">
    <canvas id="screen" width="1280" height="800" tabindex="0"></canvas>
  </div>
  <div id="toast" role="alert" hidden></div>
  <div id="overlay"></div>

  <script>
    import "../lib/takeover.ts";
  </script>
</Base>
